{
  "name": "around_the_world",
  "version": "1.0.0",
  "description": "A lightweight, static web app that visualizes visited vs. pending places on an interactive Highcharts Highmaps world map, with drilldown support for US states and India states/UTs.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint js --ignore-pattern js/lib",
    "lint:fix": "eslint js --ignore-pattern js/lib --fix",
    "format": "prettier --write \"js/**/*.js\" \"*.md\" \"*.json\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-dubaj/Around_The_World.git"
  },
  "keywords": ["highcharts", "map", "travel", "visualization"],
  "author": "Andrzej Dubaj <https://github.com/a-dubaj>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/a-dubaj/Around_The_World/issues"
  },
  "homepage": "https://github.com/a-dubaj/Around_The_World#readme",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "babel-jest": "^30.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jquery": "^1.5.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.9.6"
  }
}